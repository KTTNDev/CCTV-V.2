{
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local",
      ".secret.local"
    ],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "out",
    "predeploy": [
      "npm run check:env",
      "npm run build"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.map",
      "Untitled design (12).png",
      "file.svg",
      "globe.svg",
      "next.svg",
      "vercel.svg",
      "window.svg"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(webp|png|jpg|jpeg|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/requests/create",
        "function": {
          "functionId": "createRequest",
          "region": "asia-southeast1",
          "pinTag": true
        }
      },
      {
        "source": "/api/requests/finalize",
        "function": {
          "functionId": "finalizeRequest",
          "region": "asia-southeast1",
          "pinTag": true
        }
      },
      {
        "source": "/api/requests/track",
        "function": {
          "functionId": "trackRequest",
          "region": "asia-southeast1",
          "pinTag": true
        }
      },
      {
        "source": "/api/public/stats",
        "function": {
          "functionId": "publicStats",
          "region": "asia-southeast1",
          "pinTag": true
        }
      },
      {
        "source": "/api/admin/requests/update",
        "function": {
          "functionId": "updateRequest",
          "region": "asia-southeast1",
          "pinTag": true
        }
      },
      {
        "source": "/api/admin/cameras/manage",
        "function": {
          "functionId": "manageCamera",
          "region": "asia-southeast1",
          "pinTag": true
        }
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
