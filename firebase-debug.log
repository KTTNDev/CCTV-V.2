[debug] [2026-08-29T22:44:17.746Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/db-rawaicctv:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function isAdmin() {\n      return request.auth != null\n        && request.auth.token.get(\n          \"email\",\n          \"\"\n        ) in [\n          \"rawai.cctv@gmail.com\",\n          \"kittinanpolrob@gmail.com\",\n          \"phuketpao.evaluation@gmail.com\"\n        ];\n    }\n\n    match /cctv_requests/{requestId} {\n      // Admin อ่านข้อมูลคำร้องได้\n      // ประชาชนอ่านผ่าน Tracking Function เท่านั้น\n      allow read: if isAdmin();\n\n      // ทุกการเขียนต้องผ่าน Cloud Functions\n      allow create, update, delete: if false;\n    }\n\n    match /tracking_index/{trackingId} {\n      // เก็บ mapping และข้อมูลลับสำหรับ Tracking\n      // ใช้งานผ่าน Cloud Functions เท่านั้น\n      allow read, write: if false;\n    }\n\n    match /_system_rate_limits/{documentId} {\n      // Rate Limit เป็นข้อมูลภายในระบบ\n      allow read, write: if false;\n    }\n\n    match /site_analytics/{documentId} {\n      // Admin อ่านรายงานได้\n      // การนับผู้เข้าชมทำผ่าน Public Stats Function\n      allow read: if isAdmin();\n      allow write: if false;\n    }\n\n    match /audit_logs/{auditId} {\n      // Admin อ่าน Audit Log ได้\n      // การสร้าง Audit Log ทำผ่าน Cloud Functions เท่านั้น\n      allow read: if isAdmin();\n      allow write: if false;\n    }\n\n    match /public_cameras/{cameraId} {\n      // ประชาชนอ่านได้เฉพาะรายการที่อนุมัติให้เผยแพร่\n      // Admin อ่านได้ทั้งรายการเผยแพร่และรายการร่าง\n      allow read: if isAdmin()\n        || resource.data.published == true;\n\n      // การเพิ่มและแก้ไขต้องผ่าน manageCamera Function\n      allow write: if false;\n    }\n\n    match /camera_private_configs/{cameraId} {\n      // IP, RTSP path และข้อมูลทรัพย์สินอ่านได้เฉพาะ Admin\n      allow read: if isAdmin();\n      allow write: if false;\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n"}]}}
